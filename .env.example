# Discord Bot Authentication
DISCORD_TOKEN=your_bot_token_here

# Optional: Specific Guild ID for instant slash command registration (leave blank for global sync)
GUILD_ID=

# Optional: Target Guild ID for automated server structure builder
TARGET_GUILD_ID=

# Storage configuration
DATA_DIR=data
MAX_BACKUPS=20

# Roles and Permissions (optional role name to grant tournament admin rights in addition to server administrators)
ADMIN_ROLE_NAME=Tournament Admin

# Branding & Colors (UDA Official Emerald Gemstone #10B981 & Antique Gold #D4AF37)
ORGANIZATION_NAME=UDA
EMBED_COLOR=0x10B981

# Clan Profile Showcase Extension
SHOWCASE_CHANNEL_ID=
STAFF_REVIEW_CHANNEL_ID=

# Website REST API Sync (https://unitedduelingamity.org)
WEBSITE_API_URL=https://unitedduelingamity.org/api/sync
WEBSITE_API_KEY=your_secret_api_key_here

