# Discord Bot Authentication
DISCORD_TOKEN=your_bot_token_here

# Optional: Specific Guild ID for instant slash command registration (leave blank for global sync)
GUILD_ID=

# Optional: Target Guild ID for automated server structure builder (build_ido_server.py)
TARGET_GUILD_ID=

# Storage configuration
DATA_DIR=data
MAX_BACKUPS=20

# Roles and Permissions (optional role name to grant tournament admin rights in addition to server administrators)
ADMIN_ROLE_NAME=Tournament Admin

# Branding
ORGANIZATION_NAME=IDO
EMBED_COLOR=0xF1C40F

# Clan Profile Showcase Extension
SHOWCASE_CHANNEL_ID=
STAFF_REVIEW_CHANNEL_ID=

